<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EncofradoCAD.App.Views.Dialogs.MedidaSegmentoDialog"
        Title="Medida de Segmento" Width="350" Height="200"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#1E1E1E">

    <Grid Margin="15" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Ingrese la medida exacta del segmento:"
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#E0E0E0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
            <TextBox x:Name="txtMedida" Width="100" Height="34" FontSize="16"
                     TextAlignment="Center" Background="#3A3A3A" Foreground="#E0E0E0"
                     BorderBrush="#404040" BorderThickness="1"/>
            <TextBlock Text="m" FontSize="16" VerticalAlignment="Center" Foreground="#E0E0E0"/>
        </StackPanel>

        <TextBlock x:Name="txtError" Grid.Row="2" Foreground="#FF6B6B"
                   HorizontalAlignment="Center" Margin="0,10,0,0" IsVisible="False"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Spacing="10">
            <Button Content="Cancelar" Width="80" Height="30"
                    Background="#555555" Foreground="White" Click="BtnCancelar_Click"/>
            <Button Content="Aceptar" Width="80" Height="30"
                    Background="#16A085" Foreground="White" FontWeight="Bold"
                    Click="BtnAceptar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
