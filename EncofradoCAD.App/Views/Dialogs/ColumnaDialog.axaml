<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EncofradoCAD.App.Views.Dialogs.ColumnaDialog"
        Title="Insertar Columna" Width="420" Height="500"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#1E1E1E">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Datos de la Columna" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Border Grid.Row="1" Background="#2A2A2A">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25,20,25,20" Spacing="6">

                    <TextBlock Text="Nombre de la Columna" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0"/>
                    <TextBox x:Name="txtNombre" Height="35" FontSize="12" Text="Columna 1"
                             Background="#3A3A3A" Foreground="#E0E0E0" BorderBrush="#404040" BorderThickness="1"/>

                    <TextBlock Text="Posición (metros)" FontWeight="Bold" FontSize="12" Foreground="#E0E0E0" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0" Spacing="4">
                            <TextBlock Text="Posición X (m)" FontWeight="SemiBold" FontSize="11" Foreground="#E0E0E0"/>
                            <TextBox x:Name="txtPosX" Height="35" FontSize="12" Foreground="#E0E0E0"
                                     Background="#3A3A3A" BorderBrush="#404040" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0" Spacing="4">
                            <TextBlock Text="Posición Y (m)" FontWeight="SemiBold" FontSize="11" Foreground="#E0E0E0"/>
                            <TextBox x:Name="txtPosY" Height="35" FontSize="12" Foreground="#E0E0E0"
                                     Background="#3A3A3A" BorderBrush="#404040" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tamaño de Columna (cm)" FontWeight="Bold" FontSize="12" Foreground="#E0E0E0" Margin="0,10,0,0"/>
                    <ComboBox x:Name="cmbTamanio" Height="35" FontSize="12" SelectedIndex="2" HorizontalAlignment="Stretch"
                              SelectionChanged="CmbTamanio_SelectionChanged">
                        <ComboBoxItem>20 x 20 cm</ComboBoxItem>
                        <ComboBoxItem>25 x 25 cm</ComboBoxItem>
                        <ComboBoxItem>30 x 30 cm</ComboBoxItem>
                        <ComboBoxItem>35 x 35 cm</ComboBoxItem>
                        <ComboBoxItem>40 x 40 cm</ComboBoxItem>
                        <ComboBoxItem>45 x 45 cm</ComboBoxItem>
                        <ComboBoxItem>Personalizada…</ComboBoxItem>
                    </ComboBox>

                    <Grid x:Name="PanelPersonalizado" ColumnDefinitions="*,Auto,*" IsVisible="False" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Ancho (cm)" FontWeight="SemiBold" FontSize="11" Foreground="#E0E0E0"/>
                            <TextBox x:Name="txtAncho" Height="35" FontSize="12" TextAlignment="Center"
                                     Background="#3A3A3A" Foreground="#E0E0E0" BorderBrush="#404040" BorderThickness="1"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="×" FontSize="16" Foreground="#9AA5B1"
                                   VerticalAlignment="Bottom" Margin="8,0,8,6"/>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Largo (cm)" FontWeight="SemiBold" FontSize="11" Foreground="#E0E0E0"/>
                            <TextBox x:Name="txtLargo" Height="35" FontSize="12" TextAlignment="Center"
                                     Background="#3A3A3A" Foreground="#E0E0E0" BorderBrush="#404040" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ErrorBorder" Background="#C0392B" BorderBrush="#A93226" BorderThickness="1"
                            CornerRadius="4" Padding="10" IsVisible="False" Margin="0,10,0,0">
                        <TextBlock x:Name="txtError" Foreground="#FEF5E7" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="#2A2A2A" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancelar" Width="90" Height="38"
                        Background="#555555" Foreground="White" FontWeight="SemiBold" Click="BtnCancelar_Click"/>
                <Button Content="Aceptar" Width="90" Height="38"
                        Background="#16A085" Foreground="White" FontWeight="SemiBold" Click="BtnAceptar_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
